# Copy this file to .env and fill in your own keys. Never commit .env.

# Required: Google AI Studio key (target agents + attacker)
GEMINI_API_KEY=your_gemini_key_here

# Recommended: Groq key (independent LLM juror)
GROQ_API_KEY=your_groq_key_here
JUDGE_GROQ_MODEL=openai/gpt-oss-120b
JUDGE_USE_GEMINI=0

# Models (separate models = separate free-tier quotas)
AGENT_MODEL=gemini-3.5-flash-lite
ATTACKER_MODEL=gemini-3.1-flash-lite

# Test-bed and attacker
DATA_AGENT_MODE=weak
MAX_PAIR_ATTEMPTS=4

# Lab: keep lab runs out of results/attack_results.json
LAB_SAVE_TO_PROJECT=0

# Optional extra free providers for the lab
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
